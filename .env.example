# ================================================================
#  TurboFix Frontend — Environment Variables
#  Copy to .env.local and fill in values. NEVER commit .env.local.
# ================================================================

# ── Backend API URL ───────────────────────────────────────────────
# For LOCAL development only — create .env.local (never commit it):
#   NEXT_PUBLIC_API_URL=http://localhost:5000
# When building for Netlify, do NOT set this — leave it blank so
# config.ts automatically falls back to the Render production URL.
NEXT_PUBLIC_API_URL=

# ── Site URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://turbofix.in
